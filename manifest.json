{
  "manifest_version": 3,
  "name": "Novel Downloader",
  "version": "1.0",
  "description": "Batch download novel text cleanly from web pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}